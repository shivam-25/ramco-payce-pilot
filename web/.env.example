# The Lambda Function URL that fronts the AgentCore runtime.
# No AWS credentials are ever set on Vercel: the function URL is the only
# thing the browser-facing server route can reach, and it is protected by a
# shared secret header rather than by SigV4.
PILOT_API_URL=https://xxxxx.lambda-url.ap-southeast-2.on.aws/
PILOT_API_KEY=set-me
