# Ramco Payce pilot. Inherits the folder-scoped AWS session from the parent dir.
source_up
export PILOT_ROOT="$PWD"
export AWS_REGION="ap-southeast-2"
export BEDROCK_CLASSIFY_MODEL="apac.amazon.nova-micro-v1:0"
export BEDROCK_DRAFT_MODEL="au.anthropic.claude-haiku-4-5-20251001-v1:0"
export BEDROCK_JUDGE_MODEL="au.anthropic.claude-haiku-4-5-20251001-v1:0"
export BEDROCK_EMBED_MODEL="amazon.titan-embed-text-v2:0"
export EMBED_DIMS="512"
[ -f "$PWD/.venv/bin/activate" ] && source "$PWD/.venv/bin/activate"
